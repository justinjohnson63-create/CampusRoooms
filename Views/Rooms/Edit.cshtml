@model CampusRooms.Models.Room

@{
    ViewData["Title"] = "Edit Room";
}

<h1>Edit Room</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-2">
                <label asp-for="Code" class="control-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Seats" class="control-label"></label>
                <input asp-for="Seats" class="form-control" />
                <span asp-validation-for="Seats" class="text-danger"></span>
            </div>
            <div class="form-group mb-2 form-check">
                <input class="form-check-input" asp-for="HasProjector" />
                <label class="form-check-label" asp-for="HasProjector">Has Projector</label>
            </div>
            <div class="form-group mb-2">
                <label asp-for="BuildingId" class="control-label">Building</label>
                <select asp-for="BuildingId" class="form-control" asp-items="ViewBag.BuildingId">
                    <option value="">Pick a building</option>
                </select>
                <span asp-validation-for="BuildingId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
