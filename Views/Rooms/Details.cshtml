@model CampusRooms.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<h1>Details</h1>

<div>
    <h4>Room</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Code</dt>
        <dd class="col-sm-10">@Model.Code</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Seats</dt>
        <dd class="col-sm-10">@Model.Seats</dd>
        <dt class="col-sm-2">Projector</dt>
        <dd class="col-sm-10">@(Model.HasProjector ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Building</dt>
        <dd class="col-sm-10">
            @if (Model.Building != null)
            {
                <a asp-controller="Buildings" asp-action="Details" asp-route-id="@Model.BuildingId">@Model.Building.Name</a>
            }
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <text>|</text>
    }
    <a asp-action="Index">Back to List</a>
</div>
