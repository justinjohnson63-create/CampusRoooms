@model CampusRooms.Models.Building

@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

@if (Model.Rooms == null || !Model.Rooms.Any())
{
    <p class="text-muted">No rooms in @Model.Name yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Seats</th>
                <th>Projector</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var room in Model.Rooms.OrderBy(r => r.Code))
        {
            <tr>
                <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id">@room.Code</a></td>
                <td>@room.Name</td>
                <td>@room.Seats</td>
                <td>@(room.HasProjector ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
}

<p>
    <a asp-controller="Rooms" asp-action="Index">Back to Rooms</a>
</p>
